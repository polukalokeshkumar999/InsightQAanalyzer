# InsightQA AI Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# OpenAI API Key (Optional - enables advanced AI analysis)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Jira Integration (Optional)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your_jira_api_token

# Jira test-management mapping (optional; supports Xray/Zephyr custom fields)
# Comma-separated Jira issue type names used for test searches
JIRA_TEST_ISSUE_TYPES=Test,Test Case,Test Execution
# Use Jira field IDs (for example customfield_12345), except MODULE_FIELD may also be a field name
JIRA_TEST_STATUS_FIELD=
JIRA_TEST_TYPE_FIELD=
JIRA_TEST_FOLDER_FIELD=
JIRA_TEST_MODULE_FIELD=

# QMetry Test Management for Jira Cloud (optional)
# Generate the API key in QMetry Configuration > Open API
QMETRY_BASE_URL=https://qtmcloud.qmetry.com
QMETRY_API_KEY=
# Numeric Jira project ID returned by the QMetry enabled-projects API
QMETRY_PROJECT_ID=

# Azure DevOps Integration (Optional)
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your_personal_access_token

# Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=your_encryption_key_here
