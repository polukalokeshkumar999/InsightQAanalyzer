{
  "name": "insightqa-ai",
  "version": "1.0.0",
  "description": "AI-Powered User Story QA Analyzer - Automatically reviews user stories and generates actionable testing insights",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "qa",
    "testing",
    "ai",
    "user-stories",
    "automation",
    "quality-assurance"
  ],
  "author": "InsightQA Team",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.10.0",
    "node-cache": "^5.1.2",
    "openai": "^4.20.0",
    "pdfkit": "^0.14.0",
    "sentiment": "^5.0.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
